DEBUG=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text

# Chunking (tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_TOKENS=20

# Retrieval
# Chroma's default space is L2, so this is a distance: lower is closer.
MAX_RETRIEVAL_DISTANCE=0.7
# Cap on the excerpt text handed to the model in one prompt
MAX_CONTEXT_CHARS=12000

# Vector store: chroma | qdrant
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
QDRANT_URL=http://localhost:6333

# Confluence
# https://example.atlassian.net/wiki/rest/api.
CONFLUENCE_URL=
# Organization email address used to log in to Confluence
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=["ENG"]

# Slack
# Bot User OAuth Token (xoxb-...). Scopes: channels:history, channels:read,
# groups:history, users:read. Leave blank to use an export or the fixtures.
SLACK_BOT_TOKEN=
# Fallback when there is no bot token: a workspace export .zip or unzipped dir.
SLACK_EXPORT_PATH=
# Channels to ingest, by name (no #) or id. JSON list. Empty = all public
# channels the bot is a member of.
SLACK_CHANNELS=["onboardiq-test"]
# Seconds between Slack API calls. Set to 60 for a new, non-Marketplace app
# (throttled to ~1 conversations.history/min). 0 for an older/approved app.
SLACK_MIN_REQUEST_INTERVAL=0
# Index private channels the bot is in. Off by default.
SLACK_INDEX_PRIVATE=false
