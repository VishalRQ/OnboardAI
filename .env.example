DEBUG=true

# Where the Streamlit UI reaches the FastAPI backend
ONBOARDAI_API_URL=http://localhost:8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text

# Chunking (tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_TOKENS=20

# Retrieval
# Chunks pulled per source for one question. Server-side on purpose: it trades
# answer breadth against context budget and latency. The UI displays it only.
TOP_K=4
# Chroma's default space is L2, so this is a distance: lower is closer.
MAX_RETRIEVAL_DISTANCE=0.7
# Cap on the excerpt text handed to the model in one prompt
MAX_CONTEXT_CHARS=12000

# Vector store: chroma | qdrant
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
QDRANT_URL=http://localhost:6333

# Confluence
# https://example.atlassian.net/wiki/rest/api.
CONFLUENCE_URL=
# Organization email address used to log in to Confluence
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# Default spaces to ingest when the request does not name any.
CONFLUENCE_SPACE_KEYS=["ENG"]
# Incremental-sync bookkeeping
CONFLUENCE_SYNC_STATE_PATH=./data/confluence_sync_state.json
CONFLUENCE_SYNC_OVERLAP_MINUTES=15
CONFLUENCE_RECONCILE_INTERVAL_HOURS=24
# A sync lock older than this belongs to a process that died mid-ingest and is
# taken over, so a crash cannot wedge every later run.
CONFLUENCE_SYNC_LOCK_STALE_MINUTES=120
# How long the Confluence space list is reused. The UI re-asks on every rerun.
CONFLUENCE_SPACE_CACHE_SECONDS=300

